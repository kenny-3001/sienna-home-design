---
const info = [
	{ label: 'Teléfono', value: '+51 999 999 999' },
	{ label: 'Email', value: 'hola@studiointeriores.com' },
	{ label: 'Ubicación', value: 'Lima, Perú' },
];
---

<section id="contacto" class="bg-stone-100 py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-16 lg:grid-cols-2">
			<div data-animate>
				<p class="text-sm font-medium uppercase tracking-[0.3em] text-amber-700">Contacto</p>
				<h2 class="mt-4 font-serif-display text-3xl font-semibold text-stone-900 sm:text-4xl">
					Hagamos realidad tu espacio ideal
				</h2>
				<p class="mt-4 text-stone-600 leading-relaxed">
					Cuéntanos sobre tu proyecto y te contactaremos en menos de 24 horas para agendar una
					consulta inicial sin costo.
				</p>

				<div class="mt-10 space-y-6">
					{
						info.map((item) => (
							<div class="flex items-center gap-4 border-b border-stone-200 pb-4">
								<span class="text-xs font-medium uppercase tracking-wider text-stone-400">{item.label}</span>
								<span class="font-medium text-stone-900">{item.value}</span>
							</div>
						))
					}
				</div>
			</div>

			<form data-animate data-animate-delay="1" class="rounded-2xl bg-white p-8 shadow-sm">
				<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
					<div class="sm:col-span-1">
						<label for="name" class="mb-1.5 block text-sm font-medium text-stone-700">Nombre</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-stone-900 focus:border-amber-700 focus:outline-none focus:ring-1 focus:ring-amber-700"
						/>
					</div>
					<div class="sm:col-span-1">
						<label for="email" class="mb-1.5 block text-sm font-medium text-stone-700">Email</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-stone-900 focus:border-amber-700 focus:outline-none focus:ring-1 focus:ring-amber-700"
						/>
					</div>
					<div class="sm:col-span-2">
						<label for="project-type" class="mb-1.5 block text-sm font-medium text-stone-700">Tipo de proyecto</label>
						<select
							id="project-type"
							name="project-type"
							class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-stone-900 focus:border-amber-700 focus:outline-none focus:ring-1 focus:ring-amber-700"
						>
							<option>Residencial</option>
							<option>Comercial</option>
							<option>Remodelación</option>
							<option>Consultoría</option>
						</select>
					</div>
					<div class="sm:col-span-2">
						<label for="message" class="mb-1.5 block text-sm font-medium text-stone-700">Mensaje</label>
						<textarea
							id="message"
							name="message"
							rows="4"
							required
							class="w-full resize-none rounded-lg border border-stone-300 px-4 py-2.5 text-stone-900 focus:border-amber-700 focus:outline-none focus:ring-1 focus:ring-amber-700"
						></textarea>
					</div>
				</div>

				<button
					type="submit"
					class="mt-6 w-full rounded-full bg-stone-900 px-8 py-3.5 text-sm font-medium text-white transition-colors hover:bg-amber-700"
				>
					Enviar mensaje
				</button>
			</form>
		</div>
	</div>
</section>
