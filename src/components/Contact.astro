---
const info = [
	{
		label: 'Teléfono',
		value: '+51 907 909 954',
		icon: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z',
	},
	{
		label: 'Email',
		value: 'siennahome@gmail.com',
		icon: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75',
	},
	{
		label: 'Ubicación',
		value: 'Villa El Salvador 15836',
		icon: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z',
	},
];
---

<section id="contacto" class="bg-stone-100 py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="grid grid-cols-1 gap-16 lg:grid-cols-2">
			<div data-animate>
				<div class="flex flex-col gap-8 sm:flex-row sm:items-center">
					<div>
						<p class="text-sm font-medium uppercase tracking-[0.3em] text-bronze-700">Contacto</p>
						<h3 class="mt-4 font-serif-display text-2xl font-bold uppercase leading-tight text-stone-900 sm:text-3xl">
							¡Obtén tu asesoría virtual gratuita hoy mismo!
						</h3>
						<p class="mt-4 text-stone-600 leading-relaxed">
							Cuéntanos sobre tu proyecto y te contactaremos en menos de 24 horas para agendar una
							consulta inicial sin costo.
						</p>
					</div>
					<img
						src="/images/process/contacto.png"
						alt="Miembro del equipo Sienna Home listo para ayudarte"
						class="h-40 w-40 shrink-0 object-contain sm:h-48 sm:w-48"
					/>
				</div>

				<div class="mt-10">
					<p class="text-lg font-semibold text-stone-900">Contáctanos</p>
					<div class="mt-4 space-y-4">
						{
							info.map((item) => (
								<div class="flex items-center gap-3 text-stone-700">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-bronze-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
									</svg>
									<span>{item.value}</span>
								</div>
							))
						}
					</div>
				</div>
			</div>

			<form data-animate data-animate-delay="1" class="rounded-2xl bg-white p-8 shadow-sm">
				<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
					<div class="sm:col-span-1">
						<label for="name" class="mb-1.5 block text-sm font-medium text-stone-700">Nombre</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-stone-900 focus:border-bronze-700 focus:outline-none focus:ring-1 focus:ring-bronze-700"
						/>
					</div>
					<div class="sm:col-span-1">
						<label for="email" class="mb-1.5 block text-sm font-medium text-stone-700">Email</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-stone-900 focus:border-bronze-700 focus:outline-none focus:ring-1 focus:ring-bronze-700"
						/>
					</div>
					<div class="sm:col-span-2">
						<label for="subject" class="mb-1.5 block text-sm font-medium text-stone-700">Asunto</label>
						<select
							id="subject"
							name="subject"
							class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-stone-900 focus:border-bronze-700 focus:outline-none focus:ring-1 focus:ring-bronze-700"
						>
							<option>Consulta general</option>
							<option>Servicio Básico</option>
							<option>Servicio Integral</option>
							<option>Otro</option>
						</select>
					</div>
					<div class="sm:col-span-2">
						<label for="message" class="mb-1.5 block text-sm font-medium text-stone-700">Mensaje</label>
						<textarea
							id="message"
							name="message"
							rows="4"
							required
							class="w-full resize-none rounded-lg border border-stone-300 px-4 py-2.5 text-stone-900 focus:border-bronze-700 focus:outline-none focus:ring-1 focus:ring-bronze-700"
						></textarea>
					</div>
				</div>

				<button
					type="submit"
					class="mt-6 w-full rounded-full bg-stone-900 px-8 py-3.5 text-sm font-medium text-white transition-colors hover:bg-bronze-700"
				>
					Enviar mensaje
				</button>
			</form>
		</div>
	</div>
</section>
