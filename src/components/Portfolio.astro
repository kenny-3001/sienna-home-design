---
import { categories } from '../data/categories';
---

<section id="proyectos" class="bg-stone-100 py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div data-animate class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-medium uppercase tracking-[0.3em] text-bronze-700">Proyectos</p>
			<h2 class="mt-4 font-serif-display text-3xl font-semibold text-stone-900 sm:text-4xl">
				Espacios que hemos transformado
			</h2>
		</div>

		<div class="mt-16 grid grid-cols-1 gap-x-10 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
			{
				categories.map((category, i) => (
					<div data-animate data-animate-delay={String(Math.min(i, 3))} class="text-center">
						<div class="aspect-4/3 w-full overflow-hidden rounded-2xl bg-stone-200">
							<img
								src={category.image}
								alt={category.label}
								loading="lazy"
								class="h-full w-full object-cover"
							/>
						</div>
						<h3 class="mt-6 font-serif-display text-xl font-semibold uppercase tracking-wide text-stone-900">
							{category.label}
						</h3>
						<p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-stone-600">{category.description}</p>
						{/* Inactivo hasta tener la galería completa de cada categoría; volver a <a href={`/proyectos/${category.slug}`}> cuando esté lista. */}
						<button
							type="button"
							disabled
							aria-disabled="true"
							class="mt-6 inline-flex cursor-not-allowed items-center justify-center rounded-full border border-stone-300 px-8 py-3 text-xs font-semibold uppercase tracking-wider text-stone-400"
						>
							Ver más
						</button>
					</div>
				))
			}
		</div>
	</div>
</section>
