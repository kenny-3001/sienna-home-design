---
const services = [
	{
		title: 'Diseño residencial',
		description: 'Proyectos integrales para casas y departamentos, adaptados a tu estilo de vida.',
		icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
	},
	{
		title: 'Diseño comercial',
		description: 'Espacios de trabajo, retail y hospitalidad pensados para tu marca y tus clientes.',
		icon: 'M3 21h18M5 21V7l8-4v18M19 21V11l-6-4M9 9v.01M9 12v.01M9 15v.01M9 18v.01',
	},
	{
		title: 'Consultoría de espacios',
		description: 'Asesoría en distribución, iluminación y materiales para optimizar cualquier ambiente.',
		icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
	},
	{
		title: 'Remodelación',
		description: 'Renovamos espacios existentes con una mirada moderna y funcional, cuidando cada detalle.',
		icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
	},
];
---

<section id="servicios" class="mx-auto max-w-7xl px-6 py-24 lg:px-8 lg:py-32">
	<div data-animate class="mx-auto max-w-2xl text-center">
		<p class="text-sm font-medium uppercase tracking-[0.3em] text-amber-700">Servicios</p>
		<h2 class="mt-4 font-serif-display text-3xl font-semibold text-stone-900 sm:text-4xl">
			Todo lo que tu espacio necesita
		</h2>
		<p class="mt-4 text-stone-600">
			Acompañamos cada proyecto de principio a fin, desde el concepto hasta la última pieza de decoración.
		</p>
	</div>

	<div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
		{
			services.map((service, i) => (
				<div
					data-animate
					data-animate-delay={String(Math.min(i, 3))}
					class="group rounded-2xl border border-stone-200 bg-white p-8 transition-shadow hover:shadow-xl hover:shadow-stone-200/60"
				>
					<div class="flex h-12 w-12 items-center justify-center rounded-full bg-amber-50 text-amber-700 transition-colors group-hover:bg-amber-700 group-hover:text-white">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={service.icon} />
						</svg>
					</div>
					<h3 class="mt-6 font-serif-display text-lg font-semibold text-stone-900">{service.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-stone-600">{service.description}</p>
				</div>
			))
		}
	</div>
</section>
