---
// image: cuando llegue la foto, poner la ruta aquí y reemplazar el <div> placeholder por un <img>.
const services = [
	{
		id: 'basico',
		number: '01',
		tag: 'Servicio Básico',
		title: 'El punto de partida ideal',
		image: '/images/services/servicio1.png',
		paragraphs: [
			'Si te estás mudando o vas a recibir tu nuevo departamento y necesitas un diseño interior, nuestro Servicio Básico es ideal. Incluye visita técnica y entrevista para entender tus necesidades.',
			'Creamos un modelo 3D para visualizar tu espacio y te proporcionamos una guía en PDF con moodboard, imágenes fotorealistas y presupuesto general de ejecución.',
		],
		details: {
			items: [
				{
					number: '01',
					title: 'Visita técnica',
					bullets: ['Toma de medidas', 'Registro fotográfico', 'Entrevista y asesoramiento'],
				},
				{
					number: '02',
					title: 'Diseño interior general',
					bullets: ['Modelado 3D básico'],
				},
				{
					number: '03',
					title: 'Reunión virtual',
					bullets: ['Visualización de la propuesta en 3D', 'Una modificación gratuita'],
				},
				{
					number: '04',
					title: 'Guía de diseño (PDF)',
					bullets: ['Moodboard', 'Imágenes fotorrealistas'],
				},
				{
					number: '05',
					title: 'Presupuesto de Ejecución (PDF)',
					bullets: ['Integral'],
				},
			],
			promo: 'Promociones a partir de 03 espacios a diseñar',
		},
	},
	{
		id: 'integral',
		number: '02',
		tag: 'Servicio Integral',
		title: 'Diseño con máximo detalle',
		image: '/images/services/servicio2.png',
		paragraphs: [
			'Si estás buscando un diseño con un mayor nivel de detalle, esta opción es la elección perfecta. Incluye visita técnica, entrevista y asesoría completa.',
			'Nuestro equipo realiza un minucioso modelado de mobiliario y detalles para adaptarse perfectamente a tu espacio, con planos completos y presupuesto detallado.',
		],
		details: {
			items: [
				{
					number: '01',
					title: 'Visita técnica',
					bullets: ['Toma de medidas', 'Registro fotográfico', 'Entrevista y asesoramiento'],
				},
				{
					number: '02',
					title: 'Diseño interior general',
					bullets: ['Modelado de mobiliario a detalle'],
				},
				{
					number: '03',
					title: 'Reunión virtual',
					bullets: ['Asesoría constante', 'Visualización de la propuesta en 3D', 'Dos modificaciones gratuitas'],
				},
				{
					number: '04',
					title: 'Guía de diseño (PDF)',
					bullets: [
						'Moodboard',
						'Imágenes fotorrealistas',
						'Plano de zonificación',
						'Plano de distribución',
						'Vistas isométricas',
						'Plano detalle de mobiliario',
					],
				},
				{
					number: '05',
					title: 'Presupuesto de Ejecución (PDF)',
					bullets: ['Detallado'],
				},
			],
			promo: 'Promociones a partir de 03 espacios a diseñar',
		},
	},
];
---

<section id="servicios" class="mx-auto max-w-7xl px-6 py-24 lg:px-8 lg:py-32">
	<div data-animate class="mb-16">
		<div class="flex items-center gap-3">
			<span class="h-px w-8 bg-bronze-700"></span>
			<p class="text-sm font-medium uppercase tracking-[0.3em] text-bronze-700">Servicios</p>
		</div>
		<h2 class="mt-4 font-serif-display text-4xl font-semibold leading-tight text-stone-900 sm:text-5xl">
			Lo que <br /> <span class="font-normal italic">ofrecemos</span>
		</h2>
	</div>

	<div class="grid grid-cols-1 gap-x-10 gap-y-14 lg:grid-cols-2">
		{
			services.map((service, i) => (
				<div data-animate data-animate-delay={String(Math.min(i, 3))}>
					<div class="relative aspect-16/10 w-full overflow-hidden rounded-2xl bg-stone-200">
						{service.image ? (
							<img src={service.image} alt={service.title} class="h-full w-full object-cover" />
						) : null}
						<p class="absolute left-6 top-6 font-serif-display text-6xl font-semibold text-stone-900/10">
							{service.number}
						</p>
						<span class="absolute bottom-6 left-6 rounded-full bg-stone-900 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white">
							{service.tag}
						</span>
					</div>

					<h3 class="mt-8 font-serif-display text-2xl font-semibold text-stone-900">{service.title}</h3>
					{
						service.paragraphs.map((p) => (
							<p class="mt-4 text-stone-600 leading-relaxed">{p}</p>
						))
					}

					<button
						type="button"
						data-modal-open={`modal-${service.id}`}
						class="mt-6 inline-flex items-center gap-2 rounded-lg bg-stone-900 px-6 py-3 text-xs font-semibold uppercase tracking-wider text-white transition-colors hover:bg-stone-700"
					>
						Más detalles
						<span aria-hidden="true">→</span>
					</button>
				</div>
			))
		}
	</div>

	{
		services.map((service) => (
			<dialog id={`modal-${service.id}`} class="m-auto max-h-[85vh] w-[calc(100%-2rem)] max-w-lg overflow-y-auto rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-stone-900/60 backdrop:backdrop-blur-sm">
				<div class="p-8">
					<div class="flex items-start justify-between gap-4">
						<div>
							<p class="text-xs font-medium uppercase tracking-[0.3em] text-bronze-700">Detalle del servicio</p>
							<h3 class="mt-2 font-serif-display text-2xl font-semibold text-stone-900">{service.tag}</h3>
						</div>
						<button
							type="button"
							data-modal-close
							aria-label="Cerrar"
							class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-stone-500 transition-colors hover:bg-stone-100 hover:text-stone-900"
						>
							✕
						</button>
					</div>

					{service.details ? (
						<>
							<p class="mt-6 text-sm font-semibold uppercase tracking-wider text-stone-900">Incluye</p>
							<ol class="mt-4 space-y-5">
								{service.details.items.map((item) => (
									<li>
										<p class="font-serif-display text-sm font-semibold text-bronze-700">{item.number}.</p>
										<p class="font-medium text-stone-900">{item.title}</p>
										<ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-stone-600">
											{item.bullets.map((bullet) => (
												<li>{bullet}</li>
											))}
										</ul>
									</li>
								))}
							</ol>
							{service.details.promo && (
								<div class="mt-6 inline-flex items-center gap-2 rounded-full bg-bronze-50 px-4 py-2 text-xs font-medium text-bronze-700">
									🏷️ {service.details.promo}
								</div>
							)}
						</>
					) : (
						<p class="mt-6 text-sm italic text-stone-400">Contenido en preparación.</p>
					)}
				</div>
			</dialog>
		))
	}
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-modal-open]').forEach((button) => {
		const dialog = document.getElementById(button.dataset.modalOpen ?? '');
		button.addEventListener('click', () => {
			if (dialog instanceof HTMLDialogElement) dialog.showModal();
		});
	});

	document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => {
		dialog.querySelectorAll('[data-modal-close]').forEach((button) => {
			button.addEventListener('click', () => dialog.close());
		});
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	});
</script>
