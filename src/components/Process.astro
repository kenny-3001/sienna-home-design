---
const rows = [
	[
		{
			number: '1',
			description: 'Eligir un servicio de diseño que deseas.',
			icon: 'M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
		},
		{
			number: '2',
			description: 'Escribirnos para continuar el proceso.',
			icon: 'M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8-1.036 0-2.03-.146-2.955-.418L3 21l1.395-4.185C3.512 15.36 3 13.732 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
		},
		{
			number: '3',
			description: 'Realizar el depósito para agendar la visita.',
			icon: 'M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3',
		},
		{
			number: '4',
			description: 'Visita técnica',
			icon: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z',
		},
	],
	[
		{
			number: '5',
			description: 'El equipo de diseño procede a realizar la propuesta.',
			icon: 'M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10',
		},
		{
			number: '6',
			description: 'Reuniones virtuales/ presenciales.',
			icon: 'M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z',
		},
		{
			number: '7',
			description: 'Aprobado el diseño, Los entregables serán enviados por correo.',
			icon: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75',
		},
	],
];
---

<section id="proceso" class="py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div data-animate class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-medium uppercase tracking-[0.3em] text-bronze-700">Cómo trabajamos</p>
			<h2 class="mt-4 font-serif-display text-3xl font-semibold text-stone-900 sm:text-4xl">Nuestro proceso</h2>
		</div>

		<div class="mt-16 space-y-16 lg:space-y-20">
			{
				rows.map((row, rowIndex) => (
					<div class="grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-4 lg:flex lg:items-start lg:justify-between lg:gap-x-4">
						{row.map((step, i) => (
							<>
								<div
									data-animate
									data-animate-delay={String(Math.min(i, 3))}
									class="flex flex-col items-center text-center lg:w-36"
								>
									<div class="relative">
										<span class="absolute -left-1.5 -top-1.5 z-10 flex h-6 w-6 items-center justify-center rounded-full bg-white text-xs font-semibold text-stone-500 shadow-sm ring-1 ring-stone-200">
											{step.number}
										</span>
										<div class="flex h-20 w-20 items-center justify-center rounded-full bg-stone-200 text-stone-800">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={step.icon} />
											</svg>
										</div>
									</div>
									<p class="mt-4 text-sm leading-relaxed text-stone-600">{step.description}</p>
								</div>
								{i < row.length - 1 && (
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="mt-8 hidden h-6 w-6 shrink-0 text-stone-300 lg:block"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 12h16m0 0l-6-6m6 6l-6 6" />
									</svg>
								)}
							</>
						))}

						{rowIndex === rows.length - 1 && (
							<>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="mt-8 hidden h-6 w-6 shrink-0 text-stone-300 lg:block"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 12h16m0 0l-6-6m6 6l-6 6" />
								</svg>
								<div data-animate class="col-span-2 flex flex-col items-center text-center sm:col-span-1 lg:w-48">
									<img
										src="/images/process/mascota.png"
										alt="Miembro del equipo Sienna Home con cinta métrica"
										class="h-44 w-44 object-contain"
									/>
									<p class="mt-4 text-sm leading-relaxed text-stone-600">
										Solicita el servicio de ejecución y nuestro equipo de producción se encarga de llevar a cabo su
										proyecto.
									</p>
								</div>
							</>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>
