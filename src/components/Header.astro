---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 bg-white border-b border-stone-200/60">
	<div id="header-bar" class="mx-auto max-w-7xl px-6 lg:px-8 flex items-center justify-between h-16 md:h-20 transition-[height] duration-300 ease-out">
		<a href="#" class="flex items-center">
			<img src="/images/sienna.jpg" alt="Sienna Home & Design" class="h-8 w-auto md:h-10" />
		</a>

		<nav class="hidden lg:flex items-center gap-6 xl:gap-10">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="whitespace-nowrap text-sm font-medium text-stone-600 hover:text-stone-900 transition-colors"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="hidden lg:flex items-center gap-5">
			<div class="flex items-center gap-4">
				{
					socials.map((social) => (
						<a
							href={social.href}
							aria-label={social.name}
							target="_blank"
							rel="noopener noreferrer"
							class="text-stone-500 hover:text-stone-900 transition-colors"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox={social.viewBox} class="h-5 w-5" fill="currentColor">
								<path d={social.path} />
							</svg>
						</a>
					))
				}
			</div>

			<a
				href="#contacto"
				class="inline-flex items-center rounded-full bg-stone-900 px-6 py-2.5 text-sm font-medium text-white hover:bg-amber-700 transition-colors"
			>
				Cotiza tu proyecto
			</a>
		</div>

		<button
			id="menu-toggle"
			aria-label="Abrir menú"
			aria-expanded="false"
			class="lg:hidden flex items-center justify-center p-2"
		>
			<span class="relative block h-[18px] w-6">
				<span class="menu-bar absolute inset-x-0 top-0 h-0.5 w-6 bg-stone-900 transition-all duration-700 ease-out"></span>
				<span class="menu-bar absolute inset-x-0 top-2 h-0.5 w-6 bg-stone-900 transition-all duration-700 ease-out"></span>
				<span class="menu-bar absolute inset-x-0 bottom-0 h-0.5 w-6 bg-stone-900 transition-all duration-700 ease-out"></span>
			</span>
		</button>
	</div>

	<nav id="mobile-menu" class="lg:hidden flex flex-col items-center gap-1 overflow-y-auto border-t border-stone-200/60 bg-white px-6 max-h-0 py-0 -translate-y-2 opacity-0 transition-all duration-700 ease-out">
		{
			links.map((link) => (
				<a href={link.href} class="w-full py-3 text-center text-sm font-medium text-stone-600 border-b border-stone-200/60 last:border-0 transition-colors hover:text-amber-700">
					{link.label}
				</a>
			))
		}

		<div class="mt-4 flex items-center gap-6">
			{
				socials.map((social) => (
					<a
						href={social.href}
						aria-label={social.name}
						target="_blank"
						rel="noopener noreferrer"
						class="text-stone-500 hover:text-stone-900 transition-colors"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox={social.viewBox} class="h-5 w-5" fill="currentColor">
							<path d={social.path} />
						</svg>
					</a>
				))
			}
		</div>

		<a href="#contacto" class="mt-4 inline-flex justify-center rounded-full bg-stone-900 px-6 py-2.5 text-sm font-medium text-white">
			Cotiza tu proyecto
		</a>
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	const setMenuOpen = (open: boolean) => {
		menu?.classList.toggle('max-h-0', !open);
		menu?.classList.toggle('py-0', !open);
		menu?.classList.toggle('-translate-y-2', !open);
		menu?.classList.toggle('opacity-0', !open);
		menu?.classList.toggle('max-h-[min(30rem,calc(100vh-4rem))]', open);
		menu?.classList.toggle('py-4', open);
		menu?.classList.toggle('translate-y-0', open);
		menu?.classList.toggle('opacity-100', open);
		toggle?.setAttribute('aria-expanded', String(open));
	};

	toggle?.addEventListener('click', () => {
		setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMenuOpen(false));
	});

	const bar = document.getElementById('header-bar');
	const SCROLL_THRESHOLD = 20;

	const updateHeaderSize = () => {
		const scrolled = window.scrollY > SCROLL_THRESHOLD;
		bar?.classList.toggle('h-14', scrolled);
		bar?.classList.toggle('h-16', !scrolled);
		bar?.classList.toggle('md:h-16', scrolled);
		bar?.classList.toggle('md:h-20', !scrolled);
	};

	updateHeaderSize();
	window.addEventListener('scroll', updateHeaderSize, { passive: true });
</script>

<style>
	#site-header {
		animation: header-drop 1.1s ease-out;
	}

	@keyframes header-drop {
		from {
			transform: translateY(-100%);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#site-header {
			animation: none;
		}
	}

	#menu-toggle .menu-bar {
		transform-origin: center;
	}

	#menu-toggle[aria-expanded='true'] .menu-bar:nth-child(1) {
		top: 0.5rem;
		transform: rotate(45deg);
	}

	#menu-toggle[aria-expanded='true'] .menu-bar:nth-child(2) {
		opacity: 0;
	}

	#menu-toggle[aria-expanded='true'] .menu-bar:nth-child(3) {
		bottom: 0.5rem;
		transform: rotate(-45deg);
	}
</style>
