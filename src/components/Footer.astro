---

<footer class="bg-stone-950 py-14">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="flex flex-col items-center text-center">
			<a href="#">
				<img src="/images/sienna-wordmark.png" alt="Sienna Home & Design" class="h-10 w-auto sm:h-12" />
			</a>

			<p class="mt-4 max-w-md text-sm text-stone-400">
				Diseño de interiores que transforma espacios en experiencias.
			</p>

			<div class="mt-6 flex items-center gap-6">
				{
					socials.map((social) => (
						<a
							href={social.href}
							aria-label={social.name}
							target="_blank"
							rel="noopener noreferrer"
							class="text-stone-400 transition-colors hover:text-white"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox={social.viewBox}>
								<path d={social.path} />
							</svg>
						</a>
					))
				}
			</div>
		</div>

		<div class="mt-10 border-t border-stone-800 pt-8 text-center text-sm text-stone-500">
			© {year} Sienna Home & Design. Todos los derechos reservados.
		</div>
	</div>
</footer>
