---
const year = new Date().getFullYear();
const social = ['Instagram', 'Pinterest', 'LinkedIn'];
---

<footer class="bg-stone-950 py-14">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div class="flex flex-col items-center justify-between gap-8 sm:flex-row">
			<a href="#" class="font-serif-display text-xl font-semibold text-white">
				Studio<span class="text-amber-500">Interiores</span>
			</a>

			<nav class="flex gap-8">
				{
					social.map((s) => (
						<a href="#" class="text-sm text-stone-400 transition-colors hover:text-white">
							{s}
						</a>
					))
				}
			</nav>
		</div>

		<div class="mt-10 border-t border-stone-800 pt-8 text-center text-sm text-stone-500">
			© {year} Studio Interiores. Todos los derechos reservados.
		</div>
	</div>
</footer>
