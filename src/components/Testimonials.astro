---
// Testimonios de ejemplo — reemplazar por los reales cuando estén disponibles.
const testimonials = [
	{
		quote: 'El equipo entendió exactamente lo que buscábamos para nuestra casa. El resultado superó nuestras expectativas.',
		name: 'María Fernanda R.',
		role: 'Proyecto residencial',
	},
	{
		quote: 'Muy profesionales y atentos a cada detalle. Nuestras oficinas ahora reflejan la identidad de la marca.',
		name: 'Carlos Medina',
		role: 'Proyecto comercial',
	},
	{
		quote: 'Cumplieron con los tiempos y el presupuesto acordado. Recomendados totalmente.',
		name: 'Lucía Torres',
		role: 'Remodelación',
	},
	{
		quote: 'Desde el primer boceto hasta la entrega, sentimos que el proyecto estaba en buenas manos. Quedamos encantados con el resultado.',
		name: 'Andrea Salazar',
		role: 'Proyecto residencial',
	},
	{
		quote: 'La comunicación fue clara en cada etapa y supieron adaptarse a nuestras ideas sin perder su toque profesional.',
		name: 'Jorge Villanueva',
		role: 'Remodelación',
	},
];
---

<section class="py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-6 lg:px-8">
		<div data-animate class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-medium uppercase tracking-[0.3em] text-bronze-700">Testimonios</p>
			<h2 class="mt-4 font-serif-display text-3xl font-semibold text-stone-900 sm:text-4xl">
				Lo que dicen nuestros clientes
			</h2>
		</div>
	</div>

	<div data-animate class="mt-16">
		<div class="mx-auto max-w-7xl px-6 lg:px-8">
			<div class="relative">
				<div
					id="testimonials-track"
					class="scrollbar-none flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4"
				>
					{
						testimonials.map((t) => (
							<div class="w-80 shrink-0 snap-start rounded-2xl bg-stone-100 p-8 sm:w-96 sm:px-14">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-bronze-700/40" fill="currentColor" viewBox="0 0 24 24">
									<path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" />
								</svg>
								<p class="mt-4 text-stone-700 leading-relaxed">{t.quote}</p>
								<div class="mt-6">
									<p class="font-semibold text-stone-900">{t.name}</p>
									<p class="text-sm text-stone-500">{t.role}</p>
								</div>
							</div>
						))
					}
				</div>

				<button
					id="testimonials-prev"
					type="button"
					aria-label="Anterior"
					class="absolute left-2 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 sm:flex items-center justify-center rounded-full bg-white/70 text-stone-900 backdrop-blur transition-colors hover:bg-white"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
					</svg>
				</button>
				<button
					id="testimonials-next"
					type="button"
					aria-label="Siguiente"
					class="absolute right-2 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 sm:flex items-center justify-center rounded-full bg-white/70 text-stone-900 backdrop-blur transition-colors hover:bg-white"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
					</svg>
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	const track = document.getElementById('testimonials-track');
	const prevButton = document.getElementById('testimonials-prev');
	const nextButton = document.getElementById('testimonials-next');

	const scrollByCard = (direction: number) => {
		if (!track) return;
		const card = track.querySelector<HTMLElement>(':scope > div');
		const gap = 24;
		const amount = (card?.offsetWidth ?? 320) + gap;
		track.scrollBy({ left: amount * direction, behavior: 'smooth' });
	};

	prevButton?.addEventListener('click', () => scrollByCard(-1));
	nextButton?.addEventListener('click', () => scrollByCard(1));
</script>
